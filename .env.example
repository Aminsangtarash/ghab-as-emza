# لوکال: اگر DB_USER / DB_PASSWORD خالی باشند، به root بدون رمز وصل می‌شود.
# سرور: فقط همین دو مقدار را پر کنید (یا DATABASE_URL کامل بگذارید).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghabazemza_db
DB_USER=
DB_PASSWORD=

