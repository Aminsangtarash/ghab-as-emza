# XAMPP MySQL / MariaDB — database ghabazemza_db
# با شماره 09121000001 و رمز Lawyer1405 وارد

# لوکال: اگر DB_USER / DB_PASSWORD خالی باشند، به root بدون رمز وصل می‌شود.
# سرور: یوزر و رمز را پر کنید.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghabazemza_db
DB_USER=
DB_PASSWORD=

# مهم برای Prisma CLI:
# دستور خام `npx prisma ...` فقط DATABASE_URL را می‌بیند.
# یا از `npm run db:push` استفاده کنید، یا این خط را کامل پر کنید:
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/ghabazemza_db"
#
# اگر DATABASE_URL پر باشد، اولویت دارد و از DB_* ساخته نمی‌شود.

# کوکی نشست: روی http://IP موقتاً false بگذارید تا مرورگر کوکی را دور نیندازد.
# بعد از فعال شدن HTTPS روی دامنه، true کنید یا حذف کنید (با X-Forwarded-Proto تشخیص داده می‌شود).
# COOKIE_SECURE=false

# sms.ir — ارسال کد تأیید ورود/ثبت‌نام (Verify API)
# کلید API را از پنل sms.ir بگیرید.
SMS_IR_API_KEY=
# شناسه قالب ارسال سریع (عدد صحیح) از بخش ارسال سریع پنل
SMS_IR_TEMPLATE_ID=
# نام پارامتر قالب (بدون #) — مثلاً CODE یا Code مطابق تعریف در پنل
SMS_IR_OTP_PARAM=CODE
# در لوکال اگر کلید تنظیم نشده باشد، کد OTP در کنسول سرور چاپ می‌شود.
# SMS_IR_DEV_LOG=true
