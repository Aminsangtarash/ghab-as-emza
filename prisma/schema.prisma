generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  phone          String          @unique
  passwordHash   String
  role           String          @default("client")
  lawyerSlug     String?         @unique
  walletBalance  Int             @default(0)
  active         Boolean         @default(true)
  email          String?
  address        String?         @db.VarChar(160)
  avatarName     String?
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  sessions       Session[]
  consultations  Consultation[]
  draft          ConsultDraft?
  conversations  Conversation[]
  walletEntries  WalletEntry[]
  messages       Message[]
  ratings        Rating[]
  documents      ConsultationDocument[]
  cases          Case[]
  appointments   Appointment[]
  lawyerNotes    LawyerNote[]
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Consultation {
  id               String         @id @default(uuid())
  userId           String
  trackingCode     String         @unique
  createdAt        DateTime       @default(now())
  channel          String
  service          String
  lawyerMode       String
  lawyerSlug       String?
  lawyerVisible    Boolean
  subject          String
  message          String         @db.Text
  urgency          String
  caseStage        String
  city             String?
  hasDocuments     String
  preferredSlot    String?
  fullName         String
  phone            String
  email            String?
  consent          Boolean
  discountCode     String?
  feeToman         Int
  originalFeeToman Int
  discountPercent  Int
  paymentStatus    String
  status           String
  cancelledAt      DateTime?
  cancelReason     String?
  refundedToman    Int            @default(0)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     Conversation?
  documents        ConsultationDocument[]
  case             Case?
  documentRequests DocumentRequest[]

  @@index([userId])
  @@index([lawyerSlug, status])
}

model ConsultationDocument {
  id             String               @id @default(uuid())
  userId         String
  consultationId String?
  storedName     String
  originalName   String
  mimeType       String
  size           Int
  createdAt      DateTime             @default(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultation   Consultation?        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  requestItem    DocumentRequestItem?

  @@index([userId, consultationId])
}

model ConsultDraft {
  userId    String   @id
  payload   Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String       @id @default(uuid())
  consultationId   String       @unique
  userId           String
  lawyerSlug       String
  createdAt        DateTime     @default(now())
  closedAt         DateTime?
  phoneCallDoneAt  DateTime?
  videoStartedAt   DateTime?
  videoEndedAt     DateTime?
  closeSummary     String?      @db.Text
  consultation     Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[]
  rating           Rating?
  appointments     Appointment[]
  notes            LawyerNote[]
  documentRequests DocumentRequest[]

  @@index([userId])
  @@index([lawyerSlug])
}

model Message {
  id              String           @id @default(uuid())
  conversationId  String
  authorRole      String
  body            String           @db.Text
  createdAt       DateTime         @default(now())
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentRequest DocumentRequest?

  @@index([conversationId, createdAt])
}

model DocumentRequest {
  id                   String                @id @default(uuid())
  conversationId       String
  consultationId       String
  messageId            String?               @unique
  note                 String?               @db.VarChar(500)
  createdByLawyerSlug  String
  createdAt            DateTime              @default(now())
  conversation         Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  consultation         Consultation          @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  message              Message?              @relation(fields: [messageId], references: [id], onDelete: SetNull)
  items                DocumentRequestItem[]

  @@index([conversationId, createdAt])
  @@index([consultationId])
}

model DocumentRequestItem {
  id             String                @id @default(uuid())
  requestId      String
  title          String                @db.VarChar(160)
  sortOrder      Int                   @default(0)
  status         String                @default("pending")
  documentId     String?               @unique
  reviewedAt     DateTime?
  rejectReason   String?               @db.VarChar(300)
  createdAt      DateTime              @default(now())
  request        DocumentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  document       ConsultationDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([requestId, sortOrder])
}

model Rating {
  id             String       @id @default(uuid())
  conversationId String       @unique
  userId         String
  score          Int
  comment        String?      @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Case {
  id             String        @id @default(uuid())
  caseNumber     String        @unique
  consultationId String?       @unique
  userId         String
  lawyerSlug     String
  title          String
  summary        String        @db.Text
  authority      String?
  courtBranch    String?
  fileNumber     String?
  stage          String
  status         String
  feeToman       Int           @default(0)
  paidToman      Int           @default(0)
  nextActionAt   DateTime?
  nextActionNote String?       @db.VarChar(300)
  clientNote     String?       @db.Text
  closeNote      String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  acceptedAt     DateTime?
  declinedAt     DateTime?
  closedAt       DateTime?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         CaseEvent[]

  @@index([lawyerSlug, status])
  @@index([userId, status])
}

model CaseEvent {
  id              String   @id @default(uuid())
  caseId          String
  kind            String
  title           String
  body            String?  @db.Text
  happensAt       DateTime?
  authorRole      String
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model Appointment {
  id             String        @id @default(uuid())
  userId         String
  lawyerSlug     String
  conversationId String?
  caseId         String?
  kind           String
  scheduledAt    DateTime
  minutes        Int           @default(30)
  status         String        @default("scheduled")
  note           String?       @db.VarChar(300)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([lawyerSlug, scheduledAt])
  @@index([userId, scheduledAt])
}

model LawyerNote {
  id             String        @id @default(uuid())
  lawyerSlug     String
  userId         String?
  conversationId String?
  caseId         String?
  body           String        @db.Text
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([lawyerSlug, createdAt])
  @@index([conversationId])
}

model LawyerProfile {
  slug           String   @id
  headline       String?  @db.VarChar(160)
  bio            String?  @db.Text
  officeHours    String?  @db.VarChar(160)
  officePhone    String?  @db.VarChar(40)
  city           String?  @db.VarChar(60)
  acceptingNew   Boolean  @default(true)
  autoAccept     Boolean  @default(false)
  active         Boolean  @default(true)
  isCustom       Boolean  @default(false)
  displayName    String?  @db.VarChar(120)
  title          String?  @db.VarChar(120)
  specialty      String?  @db.VarChar(120)
  experience     String?  @db.VarChar(80)
  years          Int?
  rating         Float?   @default(5)
  consultations  Int?     @default(0)
  image          String?  @db.VarChar(260)
  focusJson      String?  @db.Text
  updatedAt      DateTime @updatedAt
}

model PromoCode {
  code      String   @id @db.VarChar(40)
  percent   Int
  title     String   @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceFee {
  serviceSlug String   @id @db.VarChar(60)
  feeToman    Int
  updatedAt   DateTime @updatedAt
}

model WalletEntry {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  reason         String
  consultationId String?
  note           String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SupportTicket {
  id          String    @id @default(uuid())
  source      String    @default("contact")
  status      String    @default("new")
  fullName    String
  phone       String?
  email       String?
  subject     String
  body        String    @db.Text
  userId      String?
  staffNote   String?   @db.Text
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([phone])
}

model CooperationApplication {
  id             String    @id @default(uuid())
  status         String    @default("pending")
  fullName       String
  phone          String
  email          String?
  city           String
  specialty      String
  licenseNumber  String?
  experienceYears Int      @default(0)
  bio            String?   @db.Text
  message        String    @db.Text
  staffNote      String?   @db.Text
  lawyerSlug     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}
